{
  "name": "flt-payroll-management",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.13.0 <27",
    "pnpm": ">=12 <13"
  },
  "scripts": {
    "dev": "vite dev --host 127.0.0.1 --port 8765 --strictPort",
    "build": "vite build",
    "start": "node scripts/start.mjs",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck",
    "test": "node --test tests/*.test.mjs",
    "lint": "oxlint --deny-warnings && node scripts/check-file-names.mjs",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@orpc/client": "^1.16.5",
    "@orpc/contract": "^1.16.5",
    "@orpc/openapi": "^1.16.5",
